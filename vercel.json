{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/v1/cron/attendance-reminder",
      "schedule": "5 6 * * 1-5"
    },
    {
      "path": "/api/v1/cron/monthly-fees",
      "schedule": "20 4 * * *"
    }
  ]
}
